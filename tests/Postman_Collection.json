{
  "info": {
    "_postman_id": "c6239bc7-7043-4a3d-b452-192a548231ef",
    "name": "Cloud_PaaS_App_Testing_Collection",
    "description": "Collection kiểm thử tự động toàn diện cho ứng dụng Web/API PaaS (Node.js/Express) trên Render và Local.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health Check API",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Content-Type is application/json\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "",
              "pm.test(\"Response returns JSON with status OK and valid properties\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql(\"OK\");",
              "    pm.expect(jsonData).to.have.property(\"app\");",
              "    pm.expect(jsonData).to.have.property(\"environment\");",
              "    pm.expect(jsonData).to.have.property(\"platform\");",
              "});",
              "",
              "pm.test(\"Response time is acceptable (< 5000ms)\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(5000);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "health"
          ]
        },
        "description": "Kiểm tra tình trạng hoạt động của Web Server, tên ứng dụng và nền tảng đang chạy (Render/Local)."
      },
      "response": []
    },
    {
      "name": "2. Weather API - Success (Hanoi)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verify weather payload data fields\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"city\");",
              "    pm.expect(jsonData).to.have.property(\"temperature\");",
              "    pm.expect(jsonData).to.have.property(\"humidity\");",
              "    pm.expect(jsonData).to.have.property(\"windKmh\");",
              "    pm.expect(jsonData).to.have.property(\"description\");",
              "    pm.expect(typeof jsonData.temperature).to.eql(\"number\");",
              "    pm.expect(typeof jsonData.humidity).to.eql(\"number\");",
              "    pm.expect(typeof jsonData.windKmh).to.eql(\"number\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/weather?city=Hanoi",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "weather"
          ],
          "query": [
            {
              "key": "city",
              "value": "Hanoi"
            }
          ]
        },
        "description": "Lấy dữ liệu thời tiết hợp lệ cho thành phố Hà Nội."
      },
      "response": []
    },
    {
      "name": "3. Weather API - Success (Ho Chi Minh)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verify valid city returned\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.city.toLowerCase()).to.satisfy(function(c) {",
              "        return c.includes(\"ho chi minh\") || c.includes(\"hồ chí minh\");",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/weather?city=Ho Chi Minh",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "weather"
          ],
          "query": [
            {
              "key": "city",
              "value": "Ho Chi Minh"
            }
          ]
        },
        "description": "Lấy dữ liệu thời tiết hợp lệ cho thành phố Hồ Chí Minh."
      },
      "response": []
    },
    {
      "name": "4. Weather API - Missing City Param (400 Bad Request)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400 Bad Request\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test(\"Returns validation error message\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.error).to.eql(\"Vui lòng nhập tên thành phố\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/weather",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "weather"
          ]
        },
        "description": "Kiểm thử trường hợp người dùng không truyền tham số city."
      },
      "response": []
    },
    {
      "name": "5. Weather API - City Not Found (404 Not Found)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 404 Not Found\", function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "",
              "pm.test(\"Returns not found error message\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.error).to.eql(\"Không tìm thấy thành phố\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
